{
  "model_name": "CrazeAI-Base-65M",
  "architecture": "craze-decoder-v2",
  "vocab_size": 16384,
  "block_size": 2048,
  "n_embd": 768,
  "n_layer": 12,
  "n_head": 12,
  "n_kv_head": 4,
  "ffn_dim": 2048,
  "dropout": 0.0,
  "rope_base": 10000,
  "tie_embeddings": true,
  "training": {
    "batch_size": 8,
    "gradient_accumulation": 16,
    "learning_rate": 0.0002,
    "min_learning_rate": 0.00002,
    "weight_decay": 0.1,
    "warmup_steps": 1000,
    "max_steps": 200000,
    "grad_clip": 1.0,
    "seed": 42,
    "precision": "bf16"
  },
  "special_tokens": {
    "pad": 0,
    "bos": 1,
    "eos": 2,
    "unk": 3,
    "user": 4,
    "assistant": 5,
    "system": 6,
    "tool": 7
  }
}
