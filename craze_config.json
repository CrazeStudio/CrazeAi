{
  "model_name": "CrazeAI-Base-32M",
  "architecture": "craze-decoder-v1",
  "vocab_size": 8192,
  "block_size": 2048,
  "n_embd": 512,
  "n_layer": 8,
  "n_head": 8,
  "n_kv_head": 2,
  "ffn_dim": 1408,
  "dropout": 0.0,
  "rope_base": 10000,
  "tie_embeddings": true,
  "training": {
    "batch_size": 8,
    "gradient_accumulation": 8,
    "learning_rate": 0.0003,
    "min_learning_rate": 0.00003,
    "weight_decay": 0.1,
    "warmup_steps": 500,
    "max_steps": 100000,
    "grad_clip": 1.0,
    "seed": 42,
    "precision": "bf16"
  },
  "special_tokens": {
    "pad": 0,
    "bos": 1,
    "eos": 2,
    "unk": 3
  }
}
